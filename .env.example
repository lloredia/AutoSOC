# AutoSOC local demo. Copy to .env if you want to override defaults.
# No secrets belong in this file.

PORT=8787
HOST=0.0.0.0
DEMO_MODE=true
LIVE_INTERVAL_MS=3000
SAMPLE_EVENTS_PATH=data/sample-events.jsonl
SAMPLE_IOCS_PATH=data/sample-iocs.json

# Used by scripts/integration_bridge.py when tailing an external HoneyTrap spool.
# Leave SENTINELFORGE_API empty unless you have that service running.
HONEYTRAP_EVENTS_DIR=data
SENTINELFORGE_API=
NEXUSWATCH_API=http://localhost:8787
